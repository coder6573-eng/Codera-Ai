{
  "name": "codera-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test:e2e": "playwright test",
    "desktop:dist": "npm run build && npm run prepare:desktop-browser && electron-builder --win portable nsis --x64",
    "android:sync": "npm run build && cap sync android",
    "prepare:desktop-browser": "node scripts/prepare-desktop-browser.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@capacitor/core": "^7.4.3",
    "@capacitor/android": "^7.4.3",
    "lucide-react": "^0.468.0",
    "fflate": "^0.8.2",
    "@capacitor/filesystem": "^7.1.4",
    "node": "^22.17.0",
    "npm": "^11.6.2",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@capacitor/cli": "^7.4.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "ai.codera.app",
    "productName": "Codera AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Codera-AI-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Codera-AI-${version}-${arch}-portable.${ext}"
    },
    "publish": null,
    "nsis": {
      "artifactName": "Codera-AI-${version}-${arch}-setup.${ext}"
    },
    "asarUnpack": [
      "node_modules/node/bin/**",
      "node_modules/npm/**"
    ],
    "extraResources": [
      {
        "from": ".codera-browser-cache",
        "to": "playwright-browsers",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
